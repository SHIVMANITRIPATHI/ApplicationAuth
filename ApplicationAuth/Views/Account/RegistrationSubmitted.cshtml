@{
    ViewData["Title"] = "Registration Submitted";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4 p-lg-5 text-center">
                <h2 class="h3 mb-3">Registration submitted</h2>
                <p class="mb-0">Your registration has been submitted and is awaiting administrator approval.</p>
                <div class="mt-4">
                    <a asp-action="Login" class="btn btn-primary">Return to login</a>
                </div>
            </div>
        </div>
    </div>
</div>
