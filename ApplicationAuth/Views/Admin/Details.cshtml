@model ApplicationAuth.Models.ApplicationUser
@{
    ViewData["Title"] = "User details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h3 mb-0">User details</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to users</a>
</div>

<dl class="row">
    <dt class="col-sm-3">Full name</dt>
    <dd class="col-sm-9">@Model.FullName</dd>
    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.Email</dd>
    <dt class="col-sm-3">Username</dt>
    <dd class="col-sm-9">@Model.UserName</dd>
    <dt class="col-sm-3">Account status</dt>
    <dd class="col-sm-9">@Model.AccountStatus</dd>
    <dt class="col-sm-3">Approval</dt>
    <dd class="col-sm-9">@(Model.IsApproved ? "Approved" : "Not approved")</dd>
    <dt class="col-sm-3">Account</dt>
    <dd class="col-sm-9">@(Model.IsActive ? "Active" : "Inactive")</dd>
    <dt class="col-sm-3">Created</dt>
    <dd class="col-sm-9">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
    <dt class="col-sm-3">Last login</dt>
    <dd class="col-sm-9">@(Model.LastLoginAt?.ToString("yyyy-MM-dd HH:mm") ?? "Never")</dd>
</dl>
