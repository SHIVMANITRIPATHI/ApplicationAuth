@model int
@{
    ViewData["Title"] = Model == 404 ? "Page not found" : "Request could not be completed";
}

<div class="text-center py-5">
    @if (Model == 404)
    {
        <h1 class="h3">Page not found</h1>
        <p class="text-muted">The page you requested could not be found.</p>
    }
    else if (Model == 403)
    {
        <h1 class="h3">Access denied</h1>
        <p class="text-muted">Your account does not have permission to complete this request.</p>
    }
    else
    {
        <h1 class="h3">Request could not be completed</h1>
        <p class="text-muted">Please try again or return to the home page.</p>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Return home</a>
</div>
