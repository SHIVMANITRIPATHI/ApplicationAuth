@{
    ViewData["Title"] = "Home";
}

<div class="text-center py-5">
    <h1 class="display-6 fw-semibold mb-3">Secure authentication for your application</h1>
    <p class="lead text-muted mb-4">Built with ASP.NET Core Identity, role-based authorization, and OTP-driven account security.</p>
    <div class="d-flex justify-content-center gap-3 flex-wrap">
        <a asp-controller="Account" asp-action="Register" class="btn btn-primary">Register</a>
        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary">Login</a>
    </div>
</div>
